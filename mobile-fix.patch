diff --git a/css/layout.css b/css/layout.css
index 61c18a8..7033292 100644
--- a/css/layout.css
+++ b/css/layout.css
@@ -6,10 +6,20 @@
   position: sticky;
   top: 0;
   z-index: 1000;
+  border-bottom: 1px solid var(--hairline);
+}
+
+/* The frosted-glass background lives on a pseudo-element, NOT on .navbar itself.
+   backdrop-filter on .navbar makes it the containing block for the position:fixed
+   mobile menu, which squashes the menu and widens the page to 2x on phones. */
+.navbar::before {
+  content: '';
+  position: absolute;
+  inset: 0;
+  z-index: -1;
   background: rgba(250, 248, 243, 0.85);
   backdrop-filter: blur(14px);
   -webkit-backdrop-filter: blur(14px);
-  border-bottom: 1px solid var(--hairline);
 }
 
 .navbar__inner {
